# Cấu hình riêng của máy. Sao chép thành backend\.env (bản đóng gói: DuLieu\.env).
# Khoá API và model cũng đặt được trong app: Cài đặt → AI trả lời bình luận.

# --- DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=CHANGE_ME
# "deepseek-flash" = DeepSeek V4.1 Flash (khuyên dùng).
DEEPSEEK_MODEL=deepseek-flash
# 1 = trả lời không bật suy luận (nhanh, ~1 giây). Việc HỌC luôn bật suy luận.
DEEPSEEK_DISABLE_THINKING=1
DEEPSEEK_REASONING_EFFORT=high

# --- Trả lời bình luận
CHAT_HOST=127.0.0.1
CHAT_PORT=8793
# TikTok cho tối đa 150 ký tự, tính cả "@tên_khách ".
CHAT_MAX_CHARS=150
CHAT_MAX_TOKENS=2400
CHAT_TEMPERATURE=0.8
MEMORY_MAX_TURNS=5
# Thu toàn bộ luồng bình luận vào logs/raw_stream (1 = bật). Tắt là mất dữ liệu phiên đó.
RAW_STREAM_ENABLED=1

# --- Tài khoản chủ shop (không trả lời chính mình). Nhiều giá trị cách nhau bằng dấu phẩy.
TIKTOK_HOST_USER_IDS=
TIKTOK_HOST_UNIQUE_IDS=

# --- Tuỳ chọn (thường để trống)
# Nguồn gói hồ sơ sản phẩm dùng chung (file .json hoặc https://…).
KNOWLEDGE_PACKAGE_SOURCE=
# Thiết bị âm thanh cho đồng bộ video (auto = tự dò).
KID_TE_AUDIO_DEVICE=auto
# Model chép lời khi phân tích video tải lên (mặc định: thư mục models/ hoặc "turbo").
KID_TE_WHISPER_MODEL=
# Thư mục tiện ích Chrome nếu không nằm cạnh ứng dụng (chỉ dùng khi chẩn đoán).
KID_TE_EXTENSION_DIR=
# Bản mã nguồn: thư mục repo solver 0.1.0 riêng (bản cài dùng EXE solver đi kèm).
KIDTE_CAPTCHA_SOLVER_ROOT=
# (Đổi chỗ lưu dữ liệu: đặt biến môi trường Windows KID_TE_ROOT — không đặt trong file này.)

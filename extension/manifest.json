{
  "manifest_version": 3,
  "name": "Kid TE - Ghim & AI Trả Lời",
  "version": "3.10.4",
  "description": "Tự ghim sản phẩm và tự trả lời bình luận theo từng khách qua API TikTok.",
  "icons": {
    "16": "icons/kid-te-16.png",
    "32": "icons/kid-te-32.png",
    "48": "icons/kid-te-48.png",
    "128": "icons/kid-te-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://shop.tiktok.com/*",
    "http://127.0.0.1:8793/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shop.tiktok.com/*"
      ],
      "js": [
        "live-widget.js",
        "schedule.js",
        "message-delivery.js",
        "content.js",
        "comments.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kid TE",
    "default_icon": {
      "16": "icons/kid-te-16.png",
      "32": "icons/kid-te-32.png"
    },
    "default_popup": "popup.html"
  }
}
